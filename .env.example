# Kimikazee Qwopus Environment Variables
# Copy this to .env and fill in your values

# Discord Bot Token (optional, for Discord integration)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Telegram Bot Token (optional, for Telegram integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (if using OpenRouter provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct Kimi API (if using moonshotai)
KIMI_API_KEY=your_moonshot_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Model Path (relative to project root or absolute)
MODEL_PATH=~/.hermes-beta/models/Qwen3.5-9B-Uncensored-Q8_0.gguf

# Server Settings (if running as API)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging
LOG_LEVEL=INFO
